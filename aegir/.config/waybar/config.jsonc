{
    "layer": "bottom",
    "position": "top",
    "margin-top": 5,
    "height": 40,

    "modules-left": [ "hyprland/workspaces", "cpu", "memory", "network", "custom/ping"],
    "modules-center": [ "hyprland/window" ],
    "modules-right": [ "tray", "custom/brightness", "pulseaudio", "clock"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-scroll-up": "hyprctl dispatch workspace e+1",
        "on-scroll-down": "hyprctl dispatch workspace e-1"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "tooltip-format": "User: {user}%\nSystem: {system}%\nIdle: {idle}%\nNice: {nice}%"
    },

    "memory": {
        "format": " {}%",
        "tooltip": true,
        "tooltip-format": "Used: {used}GB\nTotal: {total}GB"
    },

    "network": {
        // "interface": "wlp2*",
        "format-wifi": " {essid} [{ifname}] ({signalStrength}%)",
        "format-ethernet": " {ifname}",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": " {ifname} (No IP)",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        "on-click-right": ""
    },

    "custom/ping": {
        "exec": "~/.config/waybar/scripts/ping.sh",
        "interval": 1,
        "tooltip": false
    },

    "hyprland/window": {
        "max-length": 128,
        "separate-outputs": true,
        "icon": true
    },

    "tray": {
        "icon-size": 20,
        "spacing": 8
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃚", "󰃛", "󰃜"]
    },

    "custom/brightness": {
        "format": "{icon} {percentage}%",
        "format-icons": ["󰃜", "󰃛", "󰃚"],
        "return-type": "json",
        "exec": "val=$(ddcutil --bus 8 getvcp 10 2>/dev/null | grep -oP 'current.*?=\\s*\\K[0-9]+'); [ -z \"$val\" ] && val=0; echo '{\"percentage\":'$val'}'",
        "on-scroll-up": "ddcutil --noverify --bus 8 setvcp 10 + 10",
        "on-scroll-down": "ddcutil --noverify --bus 8 setvcp 10 - 10",
        "on-click": "ddcutil --noverify --bus 8 setvcp 10 0",
        "on-click-right": "ddcutil --noverify --bus 8 setvcp 10 100",
        "interval": 1,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " MUTED",
        "format-source": "",
        "format-source-muted": "",
        "format-icons": ["", "", ""],
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%H:%M - %b %d, %Y}",
        "interval": 60,
        "tooltip": true,
        "tooltip-format": "{:%A, %B %d, %Y}\n\n"
    }
}
